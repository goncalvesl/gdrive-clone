# Maintainer: gdrive-clone contributors
pkgname=gdrive-clone
pkgver=0.1.0
pkgrel=1
pkgdesc='Prévia independente de espelhamento do Google Drive para Linux'
arch=('x86_64')
url='https://github.com/goncalvesl/gdrive-clone'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'libsecret')
makedepends=('cargo' 'rust')
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --locked --release -p drive-desktop
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 target/release/drive-desktop "${pkgdir}/usr/bin/drive-desktop"
  install -Dm644 packaging/gdrive-clone.desktop "${pkgdir}/usr/share/applications/gdrive-clone.desktop"
  install -Dm644 packaging/gdrive-clone-reference.desktop "${pkgdir}/usr/share/applications/gdrive-clone-reference.desktop"
  install -Dm644 assets/drive-linux.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/gdrive-clone.svg"
  install -Dm644 packaging/gdrive-links.xml "${pkgdir}/usr/share/mime/packages/gdrive-clone.xml"
  install -Dm644 packaging/gdrive-clone-system.service "${pkgdir}/usr/lib/systemd/user/gdrive-clone.service"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 ATTRIBUTION.md "${pkgdir}/usr/share/doc/${pkgname}/ATTRIBUTION.md"
  install -Dm644 THIRD_PARTY_LICENSES.md "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_LICENSES.md"
  for notice in packaging/licenses/*; do
    install -Dm644 "$notice" "${pkgdir}/usr/share/doc/${pkgname}/fonts/${notice##*/}"
  done
}
